<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+（API 31+）备份/迁移规则，与 backup_rules.xml 保持一致：
     数据库 + 菜谱图片目录参与云备份和设备间迁移 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="recipe_images" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="recipe_images" />
    </device-transfer>
</data-extraction-rules>
